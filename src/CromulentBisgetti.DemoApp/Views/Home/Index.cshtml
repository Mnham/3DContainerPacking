@{
    ViewData["Title"] = "Упаковка контейнеров";
}

@section Styles {
    <link href="~/css/container-packing.css" rel="stylesheet" asp-append-version="true" />
}

<div id="content" class="container py-4">
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h1 class="h5 mb-0">Алгоритмы упаковки</h1>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <caption class="visually-hidden">Выбранные алгоритмы упаковки</caption>
                            <thead>
                                <tr>
                                    <th class="button-column" scope="col" aria-label="Действия"></th>
                                    <th class="algorithm-name-column" scope="col">Используемые алгоритмы</th>
                                </tr>
                            </thead>
                            <tbody id="algorithms-to-use"></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <button id="add-algorithm" type="button" class="btn btn-success btn-sm" aria-label="Добавить алгоритм">+</button>
                        </div>
                        <div class="col">
                            <label class="visually-hidden" for="algorithm-select">Алгоритм для добавления</label>
                            <select id="algorithm-select" class="form-select form-select-sm" aria-label="Алгоритм для добавления">
                                <option value="1">EB_AFIT</option>
                                <option value="2">EB_AFIT_improved</option>
                                <option value="3">XYZRotationVertical</option>
                                <option value="4">ZRotation</option>
                                <option value="5">WithoutRotation</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Предметы для упаковки</h2>
                    <button id="generate-items" type="button" class="btn btn-outline-secondary btn-sm">Сгенерировать предметы для примера</button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <caption class="visually-hidden">Предметы, которые нужно упаковать</caption>
                            <thead>
                                <tr>
                                    <th class="button-column" scope="col" aria-label="Действия"></th>
                                    <th class="data-column text-center" scope="col">Длина</th>
                                    <th class="data-column text-center" scope="col">Ширина</th>
                                    <th class="data-column text-center" scope="col">Высота</th>
                                    <th class="data-column text-center" scope="col">Количество</th>
                                </tr>
                            </thead>
                            <tbody id="items-to-pack"></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <button id="add-item" type="button" class="btn btn-success btn-sm" aria-label="Добавить предмет">+</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Контейнеры</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <button id="generate-containers" type="button" class="btn btn-outline-secondary btn-sm">Сгенерировать контейнеры для примера</button>
                        <button id="pack-containers" type="button" class="btn btn-primary btn-sm">Упаковать</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <caption class="visually-hidden">Контейнеры и результаты упаковки</caption>
                            <thead>
                                <tr>
                                    <th class="button-column" scope="col" aria-label="Действия"></th>
                                    <th class="data-column text-center" scope="col">Длина</th>
                                    <th class="data-column text-center" scope="col">Ширина</th>
                                    <th class="data-column text-center" scope="col">Высота</th>
                                    <th class="button-column gray-cell" scope="col" aria-label="Разделитель"></th>
                                    <th class="algorithm-name-column" scope="col">Алгоритм</th>
                                    <th class="data-column text-center" scope="col">Время (мс)</th>
                                    <th class="data-column text-center" scope="col">Заполненный объём, %</th>
                                    <th class="data-column text-center" scope="col">Упаковано</th>
                                    <th class="data-column text-center" scope="col">Не упаковано</th>
                                    <th scope="col" aria-label="Визуализация"></th>
                                </tr>
                            </thead>
                            <tbody id="containers"></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <button id="add-container" type="button" class="btn btn-success btn-sm" aria-label="Добавить контейнер">+</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="renderModal" class="modal fade" tabindex="-1" aria-labelledby="renderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="renderModalLabel" class="modal-title h5">Визуализация упаковки</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body d-flex flex-column text-center p-2">
                <div id="drawing-container"></div>
                <div class="mt-2">
                    <button id="unpack-render-item" type="button" class="btn btn-outline-secondary" disabled>Назад</button>
                    <button id="pack-render-item" type="button" class="btn btn-outline-secondary" disabled>Вперёд</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/container-packing.js" asp-append-version="true"></script>
}