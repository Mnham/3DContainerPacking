@{
    ViewData["Title"] = "Container Packing";
}

@section Styles {
    <style>
        #drawing-container {
            width: 100%;
            flex: 1 1 auto;
            min-height: 0;
        }

        #drawing-container canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
        }

        table {
            font-size: 14px;
        }

        .borderless td,
        .borderless th {
            border: none !important;
        }

        .button-column {
            width: 60px;
        }

        .data-column {
            width: 80px;
        }

        .algorithm-name-column {
            width: 180px;
        }

        .gray-cell {
            background-color: #ececec;
        }
    </style>
}

<div id="content" class="container py-4">
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h1 class="h5 mb-0">Алгоритмы упаковки</h1>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th class="button-column"></th>
                                    <th class="algorithm-name-column">Используемые алгоритмы</th>
                                </tr>
                            </thead>
                            <tbody id="algorithms-to-use"></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <button id="add-algorithm" class="btn btn-success btn-sm" aria-label="Добавить алгоритм">+</button>
                        </div>
                        <div class="col">
                            <select id="algorithm-select" class="form-select form-select-sm">
                                <option value="1">EB_AFIT</option>
                                <option value="2">EB_AFIT_improved</option>
                                <option value="3">XYZRotationVertical</option>
                                <option value="4">ZRotation</option>
                                <option value="5">WithoutRotation</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Предметы для упаковки</h2>
                    <button id="generate-items" class="btn btn-outline-secondary btn-sm">Сгенерировать предметы для примера</button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th class="button-column"></th>
                                    <th class="data-column text-center">Длина</th>
                                    <th class="data-column text-center">Ширина</th>
                                    <th class="data-column text-center">Высота</th>
                                    <th class="data-column text-center">Количество</th>
                                </tr>
                            </thead>
                            <tbody id="items-to-pack"></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <button id="add-item" class="btn btn-success btn-sm" aria-label="Добавить предмет">+</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Контейнеры</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <button id="generate-containers" class="btn btn-outline-secondary btn-sm">Сгенерировать контейнеры для примера</button>
                        <button id="pack-containers" class="btn btn-primary btn-sm">УПАКОВАТЬ</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th class="button-column"></th>
                                    <th class="data-column text-center">Длина</th>
                                    <th class="data-column text-center">Ширина</th>
                                    <th class="data-column text-center">Высота</th>
                                    <th class="button-column gray-cell"></th>
                                    <th class="algorithm-name-column">Алгоритм</th>
                                    <th class="data-column text-center">Время (мс)</th>
                                    <th class="data-column text-center">Заполненный объем %</th>
                                    <th class="data-column text-center">Упаковано</th>
                                    <th class="data-column text-center">Не упаковано</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="containers"></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <button id="add-container" class="btn btn-success btn-sm" aria-label="Добавить контейнер">+</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="renderModal" class="modal fade" tabindex="-1" aria-labelledby="renderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="renderModalLabel" class="modal-title h5">Визуализация упаковки</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body d-flex flex-column text-center p-2">
                <div id="drawing-container"></div>
                <div class="mt-2">
                    <button id="unpack-render-item" class="btn btn-outline-secondary" disabled>Назад</button>
                    <button id="pack-render-item" class="btn btn-outline-secondary" disabled>Вперёд</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/container-packing.js" asp-append-version="true"></script>
}