@implements IDisposable
@inject PackingFormState State

<div class="card" aria-busy="@State.IsPacking">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h2 class="h5 mb-0">Контейнеры</h2>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@State.IsPacking" @onclick="State.GenerateSampleContainers">Сгенерировать контейнеры для примера</button>
            <button type="button" class="btn btn-primary btn-sm" disabled="@State.IsPacking" @onclick="PackContainersAsync">
                @(State.IsPacking ? "Упаковка..." : "Упаковать")
            </button>
            @if (State.IsPacking)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(packingCancellation?.IsCancellationRequested ?? false)" @onclick="CancelPacking">Отменить</button>
            }
        </div>
    </div>
    <div class="card-body">
        @if (State.IsPacking)
        {
            <div class="alert alert-info d-flex align-items-center gap-2" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>@(packingStatusMessage ?? "Выполняется упаковка. Входные данные временно заблокированы.")</span>
            </div>
        }
        else if (packingStatusMessage is not null)
        {
            <div class="alert alert-info" role="status" aria-live="polite">@packingStatusMessage</div>
        }

        @if (State.PackingErrors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <p class="fw-semibold mb-1">Не удалось выполнить упаковку:</p>
                <ul class="mb-0">
                    @foreach (string error in State.PackingErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <caption class="visually-hidden">Контейнеры и результаты упаковки</caption>
                <thead>
                    <tr>
                        <th class="button-column" scope="col" aria-label="Действия"></th>
                        <th class="data-column text-center" scope="col">Длина</th>
                        <th class="data-column text-center" scope="col">Ширина</th>
                        <th class="data-column text-center" scope="col">Высота</th>
                        <th class="button-column gray-cell" scope="col" aria-label="Разделитель"></th>
                        <th class="data-column text-center" scope="col">Время (мс)</th>
                        <th class="data-column text-center" scope="col">Заполненный объём, %</th>
                        <th class="data-column text-center" scope="col">Упаковано</th>
                        <th class="data-column text-center" scope="col">Не упаковано</th>
                        <th scope="col" aria-label="Визуализация"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int index = 0; index < State.Containers.Count; index++)
                    {
                        int containerIndex = index;
                        PackingContainerFormModel container = State.Containers[containerIndex];
                        string rowLabel = $"Контейнер {containerIndex + 1}";

                        <tr @key="container.Id">
                            <td>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@State.IsPacking" aria-label="Удалить контейнер @(containerIndex + 1)" @onclick="() => State.RemoveContainer(containerIndex)">-</button>
                            </td>
                            <td>
                                <InputNumber min="1" step="any" inputmode="decimal" class="form-control form-control-sm text-center" disabled="@State.IsPacking" @bind-Value="container.Length" aria-label="@($"{rowLabel}: Длина")" aria-invalid="@GetAriaInvalid(container, nameof(PackingContainerFormModel.Length))" title="@State.GetFieldError(container, nameof(PackingContainerFormModel.Length))" />
                                <ValidationMessage For="@(() => container.Length)" class="invalid-feedback" />
                            </td>
                            <td>
                                <InputNumber min="1" step="any" inputmode="decimal" class="form-control form-control-sm text-center" disabled="@State.IsPacking" @bind-Value="container.Width" aria-label="@($"{rowLabel}: Ширина")" aria-invalid="@GetAriaInvalid(container, nameof(PackingContainerFormModel.Width))" title="@State.GetFieldError(container, nameof(PackingContainerFormModel.Width))" />
                                <ValidationMessage For="@(() => container.Width)" class="invalid-feedback" />
                            </td>
                            <td>
                                <InputNumber min="1" step="any" inputmode="decimal" class="form-control form-control-sm text-center" disabled="@State.IsPacking" @bind-Value="container.Height" aria-label="@($"{rowLabel}: Высота")" aria-invalid="@GetAriaInvalid(container, nameof(PackingContainerFormModel.Height))" title="@State.GetFieldError(container, nameof(PackingContainerFormModel.Height))" />
                                <ValidationMessage For="@(() => container.Height)" class="invalid-feedback" />
                            </td>
                            <td class="gray-cell"></td>
                            @if (container.PackingResult is null)
                            {
                                <td colspan="5" class="text-muted">Результаты появятся после расчёта упаковки.</td>
                            }
                            else
                            {
                                var result = container.PackingResult;

                                <td class="data-column text-center">
                                    <p class="form-control-plaintext mb-0">@result.PackTimeInMilliseconds</p>
                                </td>
                                <td class="data-column text-center">
                                    <p class="form-control-plaintext mb-0">@result.PercentContainerVolumePacked</p>
                                </td>
                                <td class="data-column text-center @GetPackedCountCellClass(result)">
                                    <p class="form-control-plaintext mb-0">@(result.PackedItems?.Count ?? 0)</p>
                                </td>
                                <td class="data-column text-center @GetPackedCountCellClass(result)">
                                    <p class="form-control-plaintext mb-0">@(result.UnpackedItems?.Count ?? 0)</p>
                                </td>
                                <td class="data-column text-end">
                                    <button type="button" class="btn btn-link btn-sm" aria-label="Показать визуализацию контейнера @(containerIndex + 1)" @onclick="() => OpenVisualizationAsync(container, result)">Показать</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <button type="button" class="btn btn-success btn-sm" disabled="@State.IsPacking" aria-label="Добавить контейнер" @onclick="State.AddContainer">+</button>
    </div>
</div>

<VisualizationModal @ref="visualizationModal" />

@code {
    private CancellationTokenSource? packingCancellation;
    private string? packingStatusMessage;
    private VisualizationModal? visualizationModal;

    private async Task PackContainersAsync()
    {
        if (State.IsPacking)
        {
            return;
        }

        packingCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        packingCancellation = cancellation;
        packingStatusMessage = null;
        State.SetPackingInProgress(true);

        try
        {
            await State.PackAsync(cancellation.Token);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            packingStatusMessage = "Упаковка отменена.";
        }
        catch (Exception)
        {
            packingStatusMessage = null;
            State.ApplyPackingErrors(["Во время упаковки произошла ошибка. Проверьте входные данные и попробуйте снова."]);
        }
        finally
        {
            if (ReferenceEquals(packingCancellation, cancellation))
            {
                packingCancellation = null;
            }

            cancellation.Dispose();
            State.SetPackingInProgress(false);
        }
    }

    private void CancelPacking()
    {
        if (!State.IsPacking)
        {
            return;
        }

        packingStatusMessage = "Отмена упаковки...";
        packingCancellation?.Cancel();
    }

    private static string GetPackedCountCellClass(AlgorithmPackingResult result) =>
        (result.UnpackedItems?.Count ?? 0) == 0 && (result.PackedItems?.Count ?? 0) != 0 ? "bg-success" : string.Empty;

    private async Task OpenVisualizationAsync(PackingContainerFormModel container, AlgorithmPackingResult result)
    {
        if (visualizationModal is not null)
        {
            await visualizationModal.ShowAsync(container, result);
        }
    }

    private string? GetAriaInvalid(PackingContainerFormModel container, string fieldName) =>
        State.HasFieldError(container, fieldName) ? "true" : null;

    public void Dispose()
    {
        packingCancellation?.Cancel();
        packingCancellation?.Dispose();

        if (State.IsPacking)
        {
            State.SetPackingInProgress(false);
        }
    }
}
