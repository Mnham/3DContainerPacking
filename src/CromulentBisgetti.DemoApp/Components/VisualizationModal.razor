@implements IAsyncDisposable
@using CromulentBisgetti.DemoApp.Visualization
@inject IJSRuntime JS

<div @ref="renderModalElement" class="modal fade" tabindex="-1" aria-labelledby="@renderModalLabelId" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="@renderModalLabelId" class="modal-title h5">Визуализация упаковки</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body d-flex flex-column text-center p-2">
                <div @ref="drawingContainerElement" class="drawing-container"></div>
                <div class="mt-2">
                    <button @ref="unpackRenderItemButtonElement" type="button" class="btn btn-outline-secondary" disabled>Назад</button>
                    <button @ref="packRenderItemButtonElement" type="button" class="btn btn-outline-secondary" disabled>Вперёд</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IJSObjectReference? module;
    private IJSObjectReference? viewer;
    private readonly string renderModalLabelId = $"renderModalLabel-{Guid.NewGuid():N}";
    private ElementReference renderModalElement;
    private ElementReference drawingContainerElement;
    private ElementReference unpackRenderItemButtonElement;
    private ElementReference packRenderItemButtonElement;

    public async Task ShowAsync(PackingContainerFormModel container, AlgorithmPackingResult result)
    {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/container-packing/blazor-packing-viewer.js");
        viewer ??= await module.InvokeAsync<IJSObjectReference>(
            "createPackingViewer",
            renderModalElement,
            drawingContainerElement,
            unpackRenderItemButtonElement,
            packRenderItemButtonElement);

        await viewer.InvokeVoidAsync("open", CreateVisualizationContainer(container, result));
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (viewer is not null)
            {
                await viewer.InvokeVoidAsync("dispose");
                await viewer.DisposeAsync();
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static PackingVisualizationContainer CreateVisualizationContainer(PackingContainerFormModel container, AlgorithmPackingResult result) =>
        new(
            container.Length.GetValueOrDefault(),
            container.Width.GetValueOrDefault(),
            container.Height.GetValueOrDefault(),
            CreateVisualizationResult(result));

    private static PackingVisualizationResult CreateVisualizationResult(AlgorithmPackingResult result) =>
        new(
            CreateVisualizationItems(result.PackedItems));

    private static IReadOnlyList<PackingVisualizationItem> CreateVisualizationItems(IEnumerable<Item>? items) =>
        items?.Select(item => new PackingVisualizationItem(
            item.ID,
            item.CoordX,
            item.CoordY,
            item.CoordZ,
            item.PackDimX,
            item.PackDimY,
            item.PackDimZ)).ToList() ?? [];
}
