@inject PackingFormState State

<div class="card h-100">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h2 class="h5 mb-0">Предметы для упаковки</h2>
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@State.IsPacking" @onclick="State.GenerateSampleItems">Сгенерировать предметы для примера</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <caption class="visually-hidden">Предметы, которые нужно упаковать</caption>
                <thead>
                    <tr>
                        <th class="button-column" scope="col" aria-label="Действия"></th>
                        <th class="data-column text-center" scope="col">Длина</th>
                        <th class="data-column text-center" scope="col">Ширина</th>
                        <th class="data-column text-center" scope="col">Высота</th>
                        <th class="data-column text-center" scope="col">Количество</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int index = 0; index < State.Items.Count; index++)
                    {
                        int itemIndex = index;
                        PackingItemFormModel item = State.Items[itemIndex];
                        string rowLabel = $"Предмет {itemIndex + 1}";

                        <tr @key="item.Id">
                            <td>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@State.IsPacking" aria-label="Удалить предмет @(itemIndex + 1)" @onclick="() => State.RemoveItem(itemIndex)">-</button>
                            </td>
                            <td>
                                <InputNumber min="1" step="any" inputmode="decimal" class="form-control form-control-sm text-center" disabled="@State.IsPacking" @bind-Value="item.Length" aria-label="@($"{rowLabel}: Длина")" aria-invalid="@GetAriaInvalid(item, nameof(PackingItemFormModel.Length))" title="@State.GetFieldError(item, nameof(PackingItemFormModel.Length))" />
                                <ValidationMessage For="@(() => item.Length)" class="invalid-feedback" />
                            </td>
                            <td>
                                <InputNumber min="1" step="any" inputmode="decimal" class="form-control form-control-sm text-center" disabled="@State.IsPacking" @bind-Value="item.Width" aria-label="@($"{rowLabel}: Ширина")" aria-invalid="@GetAriaInvalid(item, nameof(PackingItemFormModel.Width))" title="@State.GetFieldError(item, nameof(PackingItemFormModel.Width))" />
                                <ValidationMessage For="@(() => item.Width)" class="invalid-feedback" />
                            </td>
                            <td>
                                <InputNumber min="1" step="any" inputmode="decimal" class="form-control form-control-sm text-center" disabled="@State.IsPacking" @bind-Value="item.Height" aria-label="@($"{rowLabel}: Высота")" aria-invalid="@GetAriaInvalid(item, nameof(PackingItemFormModel.Height))" title="@State.GetFieldError(item, nameof(PackingItemFormModel.Height))" />
                                <ValidationMessage For="@(() => item.Height)" class="invalid-feedback" />
                            </td>
                            <td>
                                <InputNumber min="1" step="1" inputmode="numeric" class="form-control form-control-sm text-center" disabled="@State.IsPacking" @bind-Value="item.Quantity" aria-label="@($"{rowLabel}: Количество")" aria-invalid="@GetAriaInvalid(item, nameof(PackingItemFormModel.Quantity))" title="@State.GetFieldError(item, nameof(PackingItemFormModel.Quantity))" />
                                <ValidationMessage For="@(() => item.Quantity)" class="invalid-feedback" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <button type="button" class="btn btn-success btn-sm" disabled="@State.IsPacking" aria-label="Добавить предмет" @onclick="State.AddItem">+</button>
    </div>
</div>

@code {
    private string? GetAriaInvalid(PackingItemFormModel item, string fieldName) =>
        State.HasFieldError(item, fieldName) ? "true" : null;
}
